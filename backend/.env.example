SECRET_KEY=
# Leave DATABASE_URL empty to use the local SQLite database.
DATABASE_URL=
DATABASE_PATH=instance/hackathon.db
HACKATHON_NAME=Hack the Future
SESSION_COOKIE_SECURE=false

# Set both values to provision the first administrator account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional SMTP settings. Without these, registrations are saved but email is unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false

# Groq chatbot settings. Add your API key only to the ignored backend/.env file.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CHATBOT_REFUSAL_MESSAGE=I can only help with questions about the Hack the Future hackathon and this website, such as registration, teams, schedule, rules, prizes and support. Please ask me something about those.
CHATBOT_MAX_MESSAGE_LENGTH=500

# Builds the keyword knowledge index; chatbot integration is not enabled in this step.
RAG_ENABLED=false

# Gemini embeddings are used by admin semantic/hybrid knowledge search.
# Set the key only in this ignored backend/.env file locally or in Render settings.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# Recommended starting point from the local RAG threshold sweep; re-evaluate after knowledge-base changes.
SEMANTIC_MIN_SCORE=0.40
