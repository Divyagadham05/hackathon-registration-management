SECRET_KEY=
# Leave DATABASE_URL empty to use the local SQLite database.
DATABASE_URL=
DATABASE_PATH=instance/hackathon.db
HACKATHON_NAME=Hack the Future
SESSION_COOKIE_SECURE=false

# Set both values to provision the first administrator account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional SMTP settings. Without these, registrations are saved but email is unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false

# Groq chatbot settings. Add your API key only to the ignored backend/.env file.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
